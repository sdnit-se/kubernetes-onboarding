// Merge into your tailnet policy file. If a section already exists, add these
// entries to it instead of replacing it.
{
	"tagOwners": {
		// Tailnet admins can create OAuth clients that carry this tag.
		"tag:k8s-operator": ["autogroup:admin"],
		// Only the operator can put this tag on the devices it creates.
		"tag:k8s": ["tag:k8s-operator"],
	},

	// Only needed if your policy does not already let your devices reach
	// everything. This lets members open apps exposed by the cluster.
	"grants": [
		{
			"src": ["autogroup:member"],
			"dst": ["tag:k8s"],
			"ip":  ["tcp:80", "tcp:443"],
		},
	],
}
