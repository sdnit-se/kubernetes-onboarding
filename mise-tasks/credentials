#!/usr/bin/env bash
#MISE description="Write kubeconfig and talosconfig from OpenTofu state into .local/"
set -euo pipefail

umask 077
mkdir -p .local
tofu -chdir=infrastructure output -raw kubeconfig >.local/kubeconfig
tofu -chdir=infrastructure output -raw talosconfig >.local/talosconfig
echo "Wrote .local/kubeconfig and .local/talosconfig. kubectl and talosctl use them inside this repository."
