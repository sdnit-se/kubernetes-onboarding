#!/usr/bin/env bash
#MISE description="Write kubeconfig and talosconfig from OpenTofu state into .local/"
set -euo pipefail

umask 077
mkdir -p .local
# Export both into a private staging directory first, so a wrong passphrase
# or a failed output leaves the current pair untouched.
staging=$(mktemp -d .local/credentials.XXXXXX)
trap 'rm -rf "$staging"' EXIT

for name in kubeconfig talosconfig; do
    if ! tofu -chdir=infrastructure output -raw "$name" >"$staging/$name" || [[ ! -s $staging/$name ]]; then
        echo "Could not read $name from OpenTofu state. Check TF_VAR_state_passphrase. .local/ was left unchanged."
        exit 1
    fi
done

chmod 600 "$staging/kubeconfig" "$staging/talosconfig"
mv -f "$staging/kubeconfig" .local/kubeconfig
mv -f "$staging/talosconfig" .local/talosconfig
echo "Wrote .local/kubeconfig and .local/talosconfig."
echo "Tasks use them, and so does mise exec -- kubectl or talosctl inside this repository."
