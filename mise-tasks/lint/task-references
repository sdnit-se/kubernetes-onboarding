#!/usr/bin/env bash
#MISE description="Check that docs and comments only tell readers to run tasks that exist"
set -euo pipefail

known=$(mise tasks ls --json | jq -r '.[].name')
status=0
while read -r task; do
    if ! grep -qxF "$task" <<<"$known"; then
        echo "Unknown task referenced: mise run $task"
        status=1
    fi
done < <(git ls-files --cached --others --exclude-standard -z -- . ':!tests' |
    xargs -0 grep -hoE 'mise run [a-z][a-z:-]*[a-z]' | awk '{print $3}' | sort -u)
exit "$status"
