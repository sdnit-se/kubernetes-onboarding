#!/usr/bin/env bash
#MISE description="Open the Argo CD dashboard through a local port-forward"
set -euo pipefail

"$(dirname "${BASH_SOURCE[0]}")/kubeconfig/check"

if password=$(kubectl --namespace argocd get secret argocd-initial-admin-secret -o go-template='{{.data.password | base64decode}}' 2>/dev/null); then
    echo "Sign in as admin with: $password"
    echo "Change it under User Info, then delete the argocd-initial-admin-secret Secret."
fi
echo "Dashboard: http://localhost:8080 (Ctrl-C to stop)"
kubectl --namespace argocd port-forward service/argocd-server 8080:80
