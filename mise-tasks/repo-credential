#!/usr/bin/env bash
#MISE description="Give Argo CD read access to a private copy of this repository with a deploy key"
#USAGE arg "<key>" help="Private half of a read-only GitHub deploy key"
set -euo pipefail

"$(dirname "${BASH_SOURCE[0]}")/kubeconfig/check"

repository=$(yq -r '.spec.generators[0].git.repoURL' kubernetes/bootstrap/apps.yaml)
if [[ $repository != git@* && $repository != ssh://* ]]; then
    echo "repoURL in kubernetes/bootstrap/apps.yaml is $repository."
    echo "Deploy keys work over SSH: set it to git@github.com:OWNER/REPO.git first."
    exit 1
fi

kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply --server-side -f -
# Applied directly rather than sealed: Argo CD needs it before it can read
# anything from Git. Keep the key in your password manager to recreate it.
kubectl create secret generic repository --namespace argocd \
    --from-literal=type=git --from-literal=url="$repository" --from-file=sshPrivateKey="$1" \
    --dry-run=client -o yaml |
    yq '.metadata.labels["argocd.argoproj.io/secret-type"] = "repository"' |
    kubectl apply --server-side -f -
echo "Argo CD can now read $repository."
